---
// Tarifas en columnas a todo el ancho sobre arena, separadas por líneas finas verticales (sin tarjetas): nombre
// en serif, texto, precio enorme con su periodo, qué incluye con una hoja y botón. La destacada es un bloque de
// terracota con la esquina de hoja. Lista `tarifas` (nombre, texto, precio, periodo, incluye «;», destacado).
// Sin precio no hay precio; sin tarifas se ve la cabecera con el botón.
import { seccion, valores } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const tarifas = s ? s.tarifas.filter((t) => t.nombre) : [];
---

{
  s && (
    <section id={id} class="banda--clara seccion">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {tarifas.length > 0 && (
          <ul class="tarifas-rejilla mt-14 md:mt-20">
            {tarifas.map((t) => (
              <li class:list={['flex flex-col px-1 py-10 sm:px-8 lg:py-12', t.destacado ? 'tarifa-destacada banda--acento hoja-peq !px-6 sm:!px-8' : 'tarifa']}>
                {t.destacado && <p class="text-xs font-semibold uppercase tracking-[.22em]">La más elegida</p>}
                <h3 class:list={['text-[clamp(1.8rem,2.4vw,2.3rem)]', t.destacado && 'mt-3']}>{t.nombre}</h3>
                {t.texto && <p class="mt-2 opacity-80">{t.texto}</p>}
                {t.precio && (
                  <p class="mt-8 leading-none">
                    <span class="serif text-[clamp(3rem,5vw,4.5rem)]">{t.precio}</span>
                    {t.periodo && <span class="mt-2 block text-sm opacity-75">{t.periodo}</span>}
                  </p>
                )}
                {valores(t.incluye).length > 0 && (
                  <ul class="mt-8 grid gap-3 border-t border-current/20 pt-6">
                    {valores(t.incluye).map((v) => (
                      <li class="flex gap-3 text-[.95rem]">
                        <Icono nombre="hoja" tam={18} class:list={['mt-0.5 shrink-0', !t.destacado && 'acento-legible']} />
                        <span>{v}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {s.cta?.url && (
                  <p class="mt-auto pt-9">
                    <a class:list={[t.destacado ? 'btn' : 'btn-sec', 'w-full sm:w-auto']} href={s.cta.url}>{s.cta.texto}</a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        )}
        {tarifas.length === 0 && s.cta?.url && <a class="btn mt-10" href={s.cta.url}>{s.cta.texto}</a>}
      </div>
    </section>
  )
}

<style>
  .tarifas-rejilla { display: grid; border-top: 1px solid color-mix(in srgb, var(--c-texto) 18%, transparent); }
  .tarifa + .tarifa { border-top: 1px solid color-mix(in srgb, var(--c-texto) 14%, transparent); }
  @media (min-width: 768px) {
    .tarifas-rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 0; }
    .tarifa, .tarifa + .tarifa { border-top: 0; border-left: 1px solid color-mix(in srgb, var(--c-texto) 14%, transparent); }
  }
  @media (min-width: 1100px) { .tarifas-rejilla { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); } }
</style>
