---
// Clases en rejilla a todo el ancho (1, 2 y 3 columnas): cada clase con su foto en forma de hoja (la esquina
// alterna), nivel y duración en píldoras, nombre en serif y texto. Sin tarjetas: todo va sobre la banda.
// Lista `clases` (nombre, texto, nivel, duracion, imagen). Si la lista está vacía usa `items` (titulo, texto),
// que es lo que escribe el alta de la web; sin ninguna de las dos se ve la cabecera con el botón.
import { seccion } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const clases = s
  ? s.clases.filter((c) => c.nombre).length
    ? s.clases.filter((c) => c.nombre)
    : s.items.filter((it) => it.titulo).map((it) => ({ nombre: it.titulo, texto: it.texto ?? '', nivel: '', duracion: '', imagen: it.imagen ?? '' }))
  : [];
---

{
  s && (
    <section id={id} class="banda--blanca seccion">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {clases.length > 0 && (
          <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 md:mt-20 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-20">
            {clases.map((c, i) => (
              <li class:list={['flex flex-col', i % 3 === 1 && 'lg:mt-16']}>
                <div class:list={['relative aspect-[4/3] overflow-hidden sm:aspect-[4/5]', i % 2 ? 'hoja-inv' : 'hoja']}>
                  <Imagen
                    src={c.imagen || '/placeholders/clase.svg'}
                    respaldo="/placeholders/clase.svg"
                    alt={altFicha(c)}
                    ancho={720}
                    alto={900}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
                {(c.nivel || c.duracion) && (
                  <p class="mt-6 flex flex-wrap gap-2">
                    {c.nivel && <span class="pastilla"><Icono nombre="nivel" tam={14} />{c.nivel}</span>}
                    {c.duracion && <span class="pastilla"><Icono nombre="reloj" tam={14} />{c.duracion}</span>}
                  </p>
                )}
                <h3 class="mt-5 text-[clamp(1.8rem,2.6vw,2.4rem)]">{c.nombre}</h3>
                {c.texto && <p class="mt-3 opacity-80">{c.texto}</p>}
              </li>
            ))}
          </ul>
        )}
        {s.cta?.url && (
          <p class="mt-14 md:mt-20">
            <a class="btn" href={s.cta.url}>{s.cta.texto}</a>
          </p>
        )}
      </div>
    </section>
  )
}
