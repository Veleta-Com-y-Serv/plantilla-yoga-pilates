---
// Preguntas frecuentes en banda de arena: título a la izquierda (fijo al hacer scroll en escritorio) con un gran
// medio sol de contorno y acordeón nativo <details> a la derecha, con preguntas en serif y un «+» en círculo.
// Sin JavaScript. Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta. Sirve para `tipo: preguntas`.
import { seccion, partirTitulo } from '../../data/site';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
const [inicio, final] = partirTitulo(s?.titulo);
---

{
  s && preguntas.length > 0 && (
    <section id={id} class="banda--clara seccion relative overflow-hidden">
      <div class="contenedor grid gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-32">
            {s.antetitulo && <p class="rotulo">{s.antetitulo}</p>}
            {s.titulo && <h2 class="titulo-seccion">{inicio}<em>{final}</em></h2>}
            {s.texto && <p class="titular-texto mt-6">{s.texto}</p>}
            <span class="preguntas-sol mt-12 hidden lg:block" aria-hidden="true" />
          </div>
        </div>
        <div class="border-b border-texto/20 lg:col-span-7">
          {preguntas.map((p) => (
            <details class="faq border-t border-texto/20">
              <summary class="flex min-h-[3.5rem] items-center gap-5 py-6">
                <span class="serif flex-1 text-[1.45rem] leading-snug md:text-[1.75rem]">{p.pregunta}</span>
                <span class="faq-signo grid h-11 w-11 shrink-0 place-items-center rounded-full border border-current/30 text-2xl leading-none" aria-hidden="true">+</span>
              </summary>
              {p.respuesta && <p class="max-w-2xl pb-8 pr-14 text-lg opacity-80">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .preguntas-sol { width: 14rem; height: 7rem; border-radius: 14rem 14rem 0 0; border: 1.5px solid var(--c-acento); border-bottom: 0; }
</style>
