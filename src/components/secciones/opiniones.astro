---
// Opiniones en banda salvia oscura honda: la primera, cita enorme en serif cursiva a todo el ancho; el resto, en
// columnas debajo con una línea fina encima. Lista `testimonios` (texto, autor). Sin opiniones no se pinta.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const opiniones = s ? s.testimonios.filter((t) => t && t.texto) : [];
const [primera, ...resto] = opiniones;
---

{
  s && opiniones.length > 0 && (
    <section id={id} class="banda--honda seccion relative overflow-hidden">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <figure class="mt-14 md:mt-20">
          <span class="serif block text-[6rem] leading-[.6] text-[var(--c-acento)]" aria-hidden="true">“</span>
          <blockquote class="serif mt-2 max-w-6xl text-[clamp(1.75rem,3.8vw,3.4rem)] italic leading-[1.18]">{primera.texto}</blockquote>
          {primera.autor && <figcaption class="mt-7 text-sm font-semibold uppercase tracking-[.2em] opacity-75">{primera.autor}</figcaption>}
        </figure>
        {resto.length > 0 && (
          <ul class="mt-16 grid gap-10 md:mt-20 md:grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] lg:gap-14">
            {resto.map((t) => (
              <li class="border-t border-current/25 pt-7">
                <blockquote class="serif text-xl italic leading-snug md:text-2xl">«{t.texto}»</blockquote>
                {t.autor && <p class="mt-5 text-sm opacity-70">{t.autor}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
