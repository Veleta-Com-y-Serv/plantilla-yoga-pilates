---
// Cabecera de banda: antetítulo con medio sol y título serif enorme con la última palabra en cursiva; en
// escritorio el texto va a la derecha, alineado abajo (a todo el ancho del contenedor).
// Adaptado de AstroWind (Headline.astro), © onWidget, MIT.
import { partirTitulo } from '../../data/site';
interface Props { titulo?: string; antetitulo?: string; texto?: string; class?: string; nivel?: 1 | 2; centrado?: boolean }
const { titulo, antetitulo, texto, class: clase = '', nivel = 2, centrado = false } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
const [inicio, final] = partirTitulo(titulo);
---

{
  (titulo || antetitulo || texto) && (
    <div class:list={[centrado ? 'mx-auto max-w-4xl text-center' : 'grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-16', clase]}>
      <div class:list={[!centrado && 'lg:col-span-7']}>
        {antetitulo && <p class="rotulo">{antetitulo}</p>}
        {titulo && <H class="titulo-seccion">{inicio}<em>{final}</em></H>}
      </div>
      {texto && <p class:list={['titular-texto', centrado ? 'mx-auto mt-6' : 'lg:col-span-5 lg:pb-3']}>{texto}</p>}
    </div>
  )
}
