---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto).
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// `prefijo` separa los ids cuando hay dos formularios en la página. `visita` añade día y clase que interesa
// (`opciones`: los nombres de las clases de site.yaml; sin opciones, el campo es de texto libre).
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; prefijo?: string; visita?: boolean; opciones?: string[] }
const {
  boton = 'Enviar mensaje',
  class: clase = '',
  asunto = `Consulta desde la web de ${site.nombre}`,
  prefijo = 'f',
  visita = false,
  opciones = [],
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (n: string) => `${prefijo}-${n}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="campo-doble">
    <div class="campo">
      <label for={id('nombre')}>Nombre</label>
      <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for={id('contacto')}>Email o teléfono</label>
      <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
    </div>
  </div>
  {
    visita && (
      <div class="campo-doble">
        <div class="campo">
          <label for={id('fecha')}>Día que prefieres</label>
          <input id={id('fecha')} name="fecha" type="date" />
        </div>
        <div class="campo">
          <label for={id('espacio')}>Qué te interesa</label>
          {opciones.length > 0 ? (
            <select id={id('espacio')} name="espacio">
              <option value="">Aún no lo sé</option>
              {opciones.map((o) => <option>{o}</option>)}
            </select>
          ) : (
            <input id={id('espacio')} name="espacio" type="text" />
          )}
        </div>
      </div>
    )
  }
  <div class="campo">
    <label for={id('mensaje')}>{visita ? 'Algo que debamos saber' : 'Mensaje'}</label>
    <textarea id={id('mensaje')} name="mensaje" rows={visita ? 3 : 4} required={!visita}></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal" class="underline">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
